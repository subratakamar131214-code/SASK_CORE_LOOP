# Documentation template only. The application reads process environment variables;
# it does NOT auto-load this file. Copy values into your shell or keep them in
# GitHub Actions Secrets for CI. Never commit a real .env file.
#
# GitHub Actions Secrets (repository -> Settings -> Secrets and variables -> Actions):
#   GROQ_API_KEY             free-tier Groq key (fast primary inference)
#   GEMINI_API_KEY           free-tier Google AI Studio key (high-context fallback)
#   FINE_GRAINED_GH_TOKEN    optional fine-grained PAT, cross-repo child creation only
#
# Local shell (Git Bash):
#   export SASK_ALLOW_NETWORK=1
#   export GROQ_API_KEY='...'
#   export GEMINI_API_KEY='...'
#
# Leave SASK_ALLOW_NETWORK unset (or 0) for fully offline deterministic runs.

SASK_ALLOW_NETWORK=0
GROQ_API_KEY=
GEMINI_API_KEY=
FINE_GRAINED_GH_TOKEN=
